# Database (Neon branch: pooled + direct; local Postgres works too)
DATABASE_URL=postgresql://postgres@localhost:5432/dmpact
DIRECT_URL=postgresql://postgres@localhost:5432/dmpact

# Neon Auth
NEON_AUTH_BASE_URL=
NEON_AUTH_COOKIE_SECRET=

# Demo creator and client for pnpm db:seed and the daily demo reset (sandbox only)
DEMO_CREATOR_EMAIL=
DEMO_CREATOR_PASSWORD=
DEMO_CREATOR_PAYPAL_EMAIL=
DEMO_CLIENT_PAYPAL_EMAIL=

# Neon Object Storage
AWS_ENDPOINT_URL_S3=
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Google Gemini
GEMINI_API_KEY=
GEMINI_MODEL=
GEMINI_FALLBACK_MODEL=
# low (default), medium or high
GEMINI_THINKING_LEVEL=

# PayPal (SANDBOX ONLY)
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
# true = in-memory mock, no PayPal calls (no credentials needed)
PAYPAL_MOCK=false
PAYPAL_SANDBOX_PERSONAL_EMAIL=

# App
APP_BASE_URL=http://localhost:3000
CRON_SECRET=
