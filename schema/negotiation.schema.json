{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "mismatch": {
      "type": "object",
      "properties": {
        "detected": {
          "type": "boolean"
        },
        "client_budget": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^\\d+(\\.\\d{1,2})?$"
            },
            {
              "type": "null"
            }
          ]
        },
        "estimated_price": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^\\d+(\\.\\d{1,2})?$"
            },
            {
              "type": "null"
            }
          ]
        },
        "currency": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[A-Z]{3}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "reason": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "detected",
        "client_budget",
        "estimated_price",
        "currency",
        "reason"
      ],
      "additionalProperties": false
    },
    "options": {
      "maxItems": 3,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "strategy": {
            "type": "string",
            "enum": [
              "reduce_scope",
              "adjust_price",
              "split_milestones"
            ]
          },
          "summary": {
            "type": "string",
            "minLength": 1
          },
          "message_draft": {
            "type": "string",
            "minLength": 1
          },
          "proposed_agreement": {
            "type": "object",
            "properties": {
              "schema_version": {
                "type": "string",
                "const": "1.0"
              },
              "service_type": {
                "type": "string",
                "enum": [
                  "mixing",
                  "mastering",
                  "mix_and_master",
                  "illustration",
                  "live2d_rigging",
                  "mv_editing",
                  "thumbnail",
                  "other"
                ]
              },
              "service_other": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "title": {
                "type": "string",
                "minLength": 1
              },
              "deliverables": {
                "minItems": 1,
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string",
                      "pattern": "^d\\d+$"
                    },
                    "description": {
                      "type": "string",
                      "minLength": 1
                    },
                    "quantity": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 9007199254740991
                    },
                    "format": {
                      "type": [
                        "string",
                        "null"
                      ]
                    }
                  },
                  "required": [
                    "id",
                    "description",
                    "quantity"
                  ],
                  "additionalProperties": false
                }
              },
              "price": {
                "type": "object",
                "properties": {
                  "total": {
                    "anyOf": [
                      {
                        "type": "string",
                        "pattern": "^\\d+(\\.\\d{1,2})?$"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "currency": {
                    "anyOf": [
                      {
                        "type": "string",
                        "pattern": "^[A-Z]{3}$"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  }
                },
                "required": [
                  "total",
                  "currency"
                ],
                "additionalProperties": false
              },
              "deposit": {
                "type": "object",
                "properties": {
                  "type": {
                    "type": "string",
                    "enum": [
                      "percent",
                      "fixed",
                      "none"
                    ]
                  },
                  "percent": {
                    "anyOf": [
                      {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 100
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "fixed_amount": {
                    "anyOf": [
                      {
                        "type": "string",
                        "pattern": "^\\d+(\\.\\d{1,2})?$"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "amount": {
                    "anyOf": [
                      {
                        "type": "string",
                        "pattern": "^\\d+(\\.\\d{1,2})?$"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  }
                },
                "required": [
                  "type",
                  "percent",
                  "fixed_amount"
                ],
                "additionalProperties": false
              },
              "balance_amount": {
                "anyOf": [
                  {
                    "type": "string",
                    "pattern": "^\\d+(\\.\\d{1,2})?$"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "deadline": {
                "type": "object",
                "properties": {
                  "date": {
                    "anyOf": [
                      {
                        "type": "string",
                        "format": "date",
                        "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "raw_text": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "is_relative": {
                    "type": "boolean"
                  }
                },
                "required": [
                  "date",
                  "is_relative"
                ],
                "additionalProperties": false
              },
              "revisions": {
                "type": "object",
                "properties": {
                  "included": {
                    "anyOf": [
                      {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 9007199254740991
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "extra_fee": {
                    "anyOf": [
                      {
                        "type": "string",
                        "pattern": "^\\d+(\\.\\d{1,2})?$"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  }
                },
                "required": [
                  "included"
                ],
                "additionalProperties": false
              },
              "usage_rights": {
                "type": "object",
                "properties": {
                  "commercial": {
                    "type": [
                      "boolean",
                      "null"
                    ]
                  },
                  "credit_required": {
                    "type": [
                      "boolean",
                      "null"
                    ]
                  },
                  "notes": {
                    "type": [
                      "string",
                      "null"
                    ]
                  }
                },
                "additionalProperties": false
              },
              "parties": {
                "type": "object",
                "properties": {
                  "client": {
                    "type": "object",
                    "properties": {
                      "display_name": {
                        "type": [
                          "string",
                          "null"
                        ]
                      },
                      "handle": {
                        "type": [
                          "string",
                          "null"
                        ]
                      },
                      "email": {
                        "anyOf": [
                          {
                            "type": "string",
                            "format": "email",
                            "pattern": "^(?:[A-Za-z0-9_'+\\-]+\\.)*[A-Za-z0-9_'+\\-]*[A-Za-z0-9_+-]@(?:[A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$"
                          },
                          {
                            "type": "null"
                          }
                        ]
                      }
                    },
                    "additionalProperties": false
                  }
                },
                "additionalProperties": false
              },
              "notes": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "ambiguities": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "code": {
                      "type": "string",
                      "enum": [
                        "MISSING_PRICE",
                        "AMBIGUOUS_CURRENCY",
                        "UNSUPPORTED_CURRENCY",
                        "CONFLICTING_VALUES",
                        "SCOPE_UNCLEAR",
                        "MISSING_DEADLINE",
                        "RELATIVE_DEADLINE",
                        "PAST_DEADLINE",
                        "MISSING_REVISIONS",
                        "VAGUE_REVISIONS",
                        "MISSING_DEPOSIT_TERMS",
                        "DEPOSIT_EXCEEDS_TOTAL",
                        "USAGE_RIGHTS_UNCLEAR",
                        "MISSING_CLIENT_EMAIL",
                        "OTHER"
                      ]
                    },
                    "severity": {
                      "type": "string",
                      "enum": [
                        "blocker",
                        "warning"
                      ]
                    },
                    "field": {
                      "type": "string",
                      "pattern": "^\\/([^/]+(\\/[^/]+)*)?$"
                    },
                    "message": {
                      "type": "string",
                      "minLength": 1
                    },
                    "source_quote": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "suggested_question": {
                      "type": [
                        "string",
                        "null"
                      ]
                    }
                  },
                  "required": [
                    "code",
                    "severity",
                    "field",
                    "message"
                  ],
                  "additionalProperties": false
                }
              },
              "extraction": {
                "type": "object",
                "properties": {
                  "model": {
                    "type": "string"
                  },
                  "prompt_version": {
                    "type": "string"
                  },
                  "confidence": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  },
                  "source_language": {
                    "type": "string"
                  }
                },
                "required": [
                  "model",
                  "prompt_version",
                  "confidence",
                  "source_language"
                ],
                "additionalProperties": false
              }
            },
            "required": [
              "schema_version",
              "service_type",
              "service_other",
              "title",
              "deliverables",
              "price",
              "deposit",
              "deadline",
              "revisions",
              "ambiguities"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "id",
          "strategy",
          "summary",
          "message_draft",
          "proposed_agreement"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "mismatch",
    "options"
  ],
  "additionalProperties": false
}
